extended:
  tags:
    RuleUfo:
      TAG_PUBLIC_HYPERWAVE_DATA: int

  scripts:
    createUnit:
      - offset: 41 #from kzer-za, randomized tus on first turn
        code: |
          var int unitTUs;
          var int partTU;
          var int turnNum;

          battle_game.getTurn turnNum;
          if eq turnNum 0;
            battle_game.randomRange partTU 30 60; #between 30 and 60% max tus
            unit.getTimeUnitsMax unitTUs;
            muldiv unitTUs partTU 100;
            unit.setTimeUnits unitTUs;
          else;
            unit.setTimeUnits 0; #for units spawned after turn one
          end;
          return;
    damageUnit:
      - offset: 16 #replaces vanilla wounds with a scaling random factor
        code: |
          var int randomFactor;

          if gt to_wound 0;
            battle_game.randomRange randomFactor 50 150; #between 5-15% of health damage
            muldiv randomFactor to_health 1000;
            if eq randomFactor 0; #we already rolled a wound, so this has to happen
              set randomFactor 1;
            end;
            set to_wound randomFactor;
          end;
          return;
      - offset: 17 #tries to prevent dying from wounds before the beginning of a new turn
        code: |
          var int currentHealth;
          var int currentWounds;
          var int currentStun;
          unit.getHealth currentHealth;

          if gt currentHealth to_health; #if you're not getting killed by damage right now
            unit.getFatalwoundsTotal currentWounds;
            add currentWounds to_wound;
            sub currentHealth to_health;
            sub currentHealth currentWounds;

            if le currentHealth 0; #if you would die from wounds, don't
              unit.getHealth currentHealth;
              unit.getStun currentStun;
              add currentStun to_stun;
              #debug_log "We're about to die. Health, Damage, Wounds, Stun:" currentHealth to_health currentWounds to_stun;

              sub to_health currentWounds;
              if lt to_health 0; #damage doesn't heal health
                set to_health 0;
              end;
              add to_stun currentWounds; #deal the lost damage as stun

              if ge currentWounds currentHealth; #if wounds is greater than health, don't
                sub currentWounds currentHealth;
                sub currentWounds 1;
                if lt currentWounds 0; #wounds don't heal wounds
                  set currentWounds 0;
                end;
                set to_wound currentWounds;
              end;

              unit.getFatalwoundsTotal currentHealth;
              add currentHealth to_wound;
              add currentHealth 1;
              mul currentHealth 5; #shock damage treshold
              if ge currentStun currentHealth; #if too much stun, don't
                unit.getStun currentStun;
                sub currentHealth 1;
                set to_stun currentHealth;
                sub to_stun currentStun;
                if lt to_stun 0; #stun doesn't wake up
                  set to_stun 0;
                end;
              end;
              #debug_log "Saved your life by reducing Damage, Wounds, Stun:" to_health to_wound to_stun unit;
            end;
          end;
          return;
      - offset: -41.3 #modified from Nord, prevents death by transformation if not dead
        code: |
          var ptr RuleArmor armorRuleset;
          var int armorSize;
          var int currentHealth;

          if eq to_transform 0; #if no transform, don't transform
            return;
          end;

          if eq to_health 0; #if no damage, don't transform
            set to_transform 0;
            return;
          end;

          unit.getRuleArmor armorRuleset;
          armorRuleset.getSize armorSize; #if too big, don't transform
          if eq armorSize 2;
            return;
          end;

          unit.getHealth currentHealth;
          if le to_health currentHealth; #if not dead, don't transform
            set to_transform 0;
            return;
          end;

          unit.setHealth 0; #if none of the above, die (and transform)
          return;
    returnFromMissionUnit: #modified from Meridian, adds extra recovery days based on fatal wounds
      - offset: 9
        code: |
          var int totalWounds;
          var int randomFactor;

          battle_game.randomRange randomFactor 150 450; #end battle wounds are worth 3x health
          unit.getFatalwoundsTotal totalWounds;
          muldiv totalWounds randomFactor 100;
          add recovery_time totalWounds;
          return;
      - offset: 9.1 #linear piecewise logarithmic approximation for recovery days 
        code: |
          if gt recovery_time 30; #if recovery days are more than 30, half the days above 30
            add recovery_time -30;
            div recovery_time 2;
            add recovery_time 30;
          end;
          if gt recovery_time 50; #if recovery days are still more than 50, third the days above 50
            add recovery_time -50;
            div recovery_time 3;
            add recovery_time 50;
          end;
          return;
    detectUfoFromBase:
      - offset: 10 #from Yankes, shows ufo data even without hyperwave decoder
        code: |
          var int showHwData;

          ufo.getTag showHwData Tag.TAG_PUBLIC_HYPERWAVE_DATA;

          if eq showHwData 1;
            var int temp DETECTION_HYPERWAVE;
            bit_xor temp DETECTION_RADAR; # remove from HW radar detection bit, it leave only HW data flag
            bit_or detection_type temp; # add only HW flag to detection
          end;
          return detection_type detection_chance;
    newMonthCountry:
      - offset: 89 #minimum +2000 funding, in order to get to the meaningful 5-20% zone faster
        code: |
          if eq fundingChange 1000;
            set fundingChange 2000;
          end;
          return fundingChange satisfaction formPact cancelPact;

ufos:
  - update: STR_HOLOUFO_SMALL
    tags:
      TAG_PUBLIC_HYPERWAVE_DATA: 1
  - update: STR_HOLOUFO_FIGHTER
    tags:
      TAG_PUBLIC_HYPERWAVE_DATA: 1
  - update: STR_UFO_AIRCAR_IRON1
    tags:
      TAG_PUBLIC_HYPERWAVE_DATA: 1
  - update: STR_UFO_AIRCAR_IRON2
    tags:
      TAG_PUBLIC_HYPERWAVE_DATA: 1
