enviroEffects:
  - type: STR_UNDERWATER_ENVIRO
    mapBackgroundColor: 141
    paletteTransformations:
      PAL_BATTLESCAPE: PAL_BATTLESCAPE_1

startingConditions:
  - type: INFILTRATION_GEAR_INFILTRATION_CRAFT
    allowedArmors: &infiltrationArmor
      - STR_PLEX_DRONE_HYBRID_ARMOR
      - STR_PLEX_DRONE_HUMAN_ARMOR
      - STR_PLEX_DRONE_SHARK_ARMOR
      - STR_PLEX_DRONE_DEEP_ARMOR
      - STR_GCIC_DRONE_HYBRID_ARMOR
      - STR_GCIC_DRONE_HUMAN_ARMOR
      - STR_GCIC_DRONE_SHARK_ARMOR
      - STR_GCIC_DRONE_DEEP_ARMOR
      - STR_DURA_DRONE_HYBRID_ARMOR
      - STR_DURA_DRONE_HUMAN_ARMOR
      - STR_DURA_DRONE_SHARK_ARMOR
      - STR_DURA_DRONE_DEEP_ARMOR
      - STR_SKELE_DRONE_HYBRID_ARMOR
      - STR_SKELE_DRONE_HUMAN_ARMOR
      - STR_SKELE_DRONE_SHARK_ARMOR
      - STR_SKELE_DRONE_DEEP_ARMOR
    allowedItemCategories:
      - STR_INFILTRATION_CATEGORY
    allowedCraft: &infiltrationCraft
      - STR_HD_CROSSOVER
      - STR_HD_HOVERBIKE
      - STR_VCM_BICUBE

  - type: TOOLS_GEAR_INFILTRATION_CRAFT
    allowedArmors: *infiltrationArmor
    allowedItemCategories:
      - STR_TOOLS_CATEGORY
    allowedCraft: *infiltrationCraft

  - type: MILSPEC_GEAR_INFILTRATION_CRAFT
    # allowedArmors:
    #   - STR_all armors are currently allowed
    forbiddenItemCategories:
      - STR_INVASION_CATEGORY
      - STR_AI_CATEGORY
    allowedCraft: *infiltrationCraft

  - type: SECURITY_GEAR
    # allowedArmors:
    #   - STR_ all armors are currently allowed
    forbiddenItemCategories:
      - STR_MILITARY_CATEGORY
      - STR_INVASION_CATEGORY

  - type: MILITARY_GEAR
    # allowedArmors:
    #   - STR_ all armors are currently allowed
    forbiddenItemCategories:
      - STR_INVASION_CATEGORY
