arcScripts:
  - type: mezonicstart
    xcomBaseInRegionTriggers:
       STR_MEZONIC_RIFTS: true
    sequentialArcs:
      - STR_BEGIN_MEZONIC
    lastMonth: 0
    maxArcs: 1

#1440 mintutes in a day
#10080 minutes in a week
#43200 minutes in a month

missionScripts:
  - type: SimSmalla
    researchTriggers:
      STR_SECGAMES_MISSIONS: false
    missionWeights:
      0:
        STR_HOLOUFO_SMALL_MISSION: 100
    targetBaseOdds: 100
    useTable: false
    startDelay: 30
    randomDelay: 43170
  - type: SimSmallb
#    researchTriggers:
#      STR_TODO: false
    missionWeights:
      0:
        STR_HOLOUFO_SMALL_MISSION: 100
    regionWeights: &PopDenseAll
      0:
        STR_MEZONIC_RIFTS: 100
        STR_MOSSWAY_COMMONS: 80
        STR_GOLDEN_REACH: 80
        STR_AZATAL_TERRACE: 80
        STR_CAYESAND_BASIN: 60
        STR_TWINGATES: 40
        STR_GLEAMING_SEAS: 40
        STR_ICEFIELDS: 20
        STR_RIMEARCH: 20
        STR_KAPISI_DESERT: 10
        STR_HEIGARA_DESERT: 10
    useTable: false
    startDelay: 30
    randomDelay: 43170
